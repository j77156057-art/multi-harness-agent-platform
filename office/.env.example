# 办公室预览层的网关设置（服务端配置，故意不带 VITE_ 前缀：带前缀会进前端产物）。
#
# 复制到当前 shell 里用，不要提交真实凭据。
# 不设这几行：界面照常打开，但顶上写「未连接正式平台」，任务、方案、额度全是空的。
#
#   $env:OFFICE_FORMAL_UPSTREAM = 'http://127.0.0.1:8848'
#   $env:OFFICE_FORMAL_TOKEN_FILE = 'D:/study/tools/agent/new agent/data/formal-operator.key'
#   $env:OFFICE_FORMAL_ADMIN_TOKEN_FILE = 'D:/study/tools/agent/new agent/data/codex-window-admin.key'
#   $env:OFFICE_FORMAL_PROJECT = '112'
#   $env:OFFICE_FORMAL_GROUP = 'office-formal-2'

# 正式平台的地址（平台自己默认跑在 8848）
OFFICE_FORMAL_UPSTREAM=http://127.0.0.1:8848

# 操作员令牌文件（浏览器用它读平台）。这是**人**的身份。
# 令牌文件在 data/ 目录下，一个文件一个身份；路径不是令牌本身。
OFFICE_FORMAL_TOKEN_FILE=D:/study/tools/agent/new agent/data/formal-operator.key

# 管理员令牌文件（只有平台助手与开工向导会用到）：这是**管理员窗口**的身份。
OFFICE_FORMAL_ADMIN_TOKEN_FILE=D:/study/tools/agent/new agent/data/codex-window-admin.key

# 这个预览服务负责哪一段
OFFICE_FORMAL_PROJECT=112
OFFICE_FORMAL_GROUP=office-formal-2

# 管理员身份（窗口 id，可选；不设就以平台认出来的那个为准）
OFFICE_FORMAL_ADMIN_SUBJECT=codex-window-admin

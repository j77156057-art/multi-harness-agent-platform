# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
# pytest 的临时目录会泄漏到工作区（如 backend/pytest-cache-files-xxxx/），
# 未被 .pytest_cache 覆盖，必须单独忽略，否则会被当成新增文件提交
pytest-cache-files-*/
*-cache-files-*/

# 运行期数据
data/
wt/
# 每个 AI 的独立工作区（见 docs/dev-convention.md「工作区隔离」）。
# 与 wt/ 不同：wt/ 是 MVP-05 的 worktree 物理目录，本项是 git worktree 隔离区。
.worktrees/
canonical.git
*.db
*.db-wal
*.db-shm
*.log

# 前端
node_modules/
dist/
.vite/

# 编辑器
.vscode/
.idea/
*.swp
.DS_Store

# 凭据（严禁提交）
.env
.env.local
*.pem
*.key
credentials.json

# 3D 场景原型：已从 GitHub 撤下，本机保留（后续再启动计划）
docs/prototypes/office-anim/

# 运行时锁文件（不是源码）
canonical.git.ensure.lock

# 转接模式的信箱（运行时产物：outbox/inbox/archive/returned）
/relay/

# 现场证据目录（当前约 74MB）：审计快照、测试分片日志、E2E 报告、复验输出。
# 生成方式：排查/回归时由命令直接写到 artifacts/<topic>-<YYYYMMDD>/ 或
# artifacts/<name>.log，例如
#   python -m pytest <files> 2>&1 | Set-Content artifacts\fs-g0.log
#   python -m pytest --collect-only -q   # 收集数对账
# 这些是「当时看到的东西」，不是源码，也不该当补丁提交；需要长期保留的
# 结论请回填到 docs/ 或任务卡，整个目录只在本机保留。
/artifacts/
